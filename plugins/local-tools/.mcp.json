{
  "mcpServers": {
    "local_tools": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.py"],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 604800,
      "omit_tools_from": ["code_mode", "deferred"],
      "timeout": 604800000,
      "env": {
        "LOCAL_TOOLS_MCP_AWAIT_OPEN_BROWSER": "0"
      }
    }
  }
}
